NODE_ENV=development

# Database (PostgreSQL 14+)
DB_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=ggames
DB_PASS=GGames9573
DB_DATABASE=kinesiology
DB_OPTIONS=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
DB_LOGGING=false

# Auth (at least 32 characters)
JWT_SECRET=change-me-with-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Optional: dedicated key for encrypting activation links in the email outbox.
# Falls back to JWT_SECRET when omitted.
MAIL_ENCRYPTION_KEY=
# Optional: dedicated HMAC key for login-attempt and audit hashes. Falls back to JWT_SECRET.
LOGIN_ATTEMPT_SECRET=
AUDIT_HASH_SECRET=

# URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8081
PORT=3000
# Set to true or a hop count when running behind a trusted reverse proxy.
TRUST_PROXY=

# Email (SMTP). Use MailHog locally, or SES/Resend/SMTP in production.
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@kinesiology.local
MAIL_FROM_NAME=Kinesiology Scheduler
MAIL_MAX_ATTEMPTS=5

# Rate limiting (global defaults; auth endpoints have stricter limits)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Temporary login lockout
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# Swagger (only honored outside production unless explicitly enabled)
SWAGGER_ENABLED=false

# Clinical workflow
# Minimum hours of anticipation for a patient to cancel or reschedule.
CANCELLATION_WINDOW_HOURS=24
# Hours ahead to enqueue appointment reminders.
REMINDER_HOURS=24

# Data retention (days). Set 0 to purge as soon as the daily job runs.
AUDIT_RETENTION_DAYS=365
LOGIN_ATTEMPT_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=90

# Rate limit store: "memory" (single instance) or "postgres" (horizontally scalable).
RATE_LIMIT_STORE=memory

# Metrics endpoint. In production, either set METRICS_ENABLED=true or METRICS_TOKEN.
METRICS_ENABLED=false
METRICS_TOKEN=

# Structured JSON logs are always used; LOG_LEVEL=error silences non-error logs.
LOG_LEVEL=log
